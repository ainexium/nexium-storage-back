# Database
# Local (Docker) :
DATABASE_URL=postgres://nexium:nexium@localhost:5433/nexium_storage?sslmode=disable
# Production (Supabase pooler — Settings > Database > Connection pooler, port 6543) :
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Server
PORT=8080
APP_URL=http://localhost:8080

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=nexium-storage
R2_PUBLIC_URL=https://pub-xxx.r2.dev  # deprecated
CDN_URL=https://cdn.nexiumai.io

# File limits
MAX_FILE_SIZE_MB=100
STORAGE_QUOTA_GB=10

# Mailjet (optional — codes are logged to stdout if not set)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=noreply@nexium.ai
MAIL_FROM_NAME=NEXIUM Storage

# Adullam (mobile money payments — adullam.dev)
ADULLAM_API_KEY=adullam_prod_xxx
ADULLAM_WEBHOOK_SECRET=your-webhook-secret
